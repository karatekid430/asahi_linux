			compatible = "apple,t6000-dart";
			reg = <0x7 0x01a80000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ DIE_NO 1309 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
