	/* USB4 / Thunderbolt host router for the first USB-C port. */
	DIE_NODE(usb4_0_acio): usb4@701db0000 {
		compatible = "apple,t8103-usb4-acio";
		reg = <0x7 0x01db0000 0x0 0x30004>,
			<0x7 0x01ac0000 0x0 0x4000>,
			<0x7 0x01080000 0x0 0x20000>,
			<0x7 0x01ac4000 0x0 0x4000>,
			<0x7 0x01ac8000 0x0 0x4000>,
			<0x7 0x01e44000 0x0 0x4000>;
		reg-names = "ctrl", "rc", "sram", "fabric-rx", "fabric-tx", "pcie";
		apple,tunable-rc = <0x0 0xfff0 0x2010>,
			<0x2c 0x4 0x0>, <0xac 0xffffffff 0x200020>;

		/* pcie_adapter_regs_tunables from ACIO reg[5] in the T6000 ADT. */
		apple,tunable-pcie = <0x1008 0x6 0x6>;

		mboxes = <&DIE_NODE(usb4_0_mbox)>;

		/*
		 * ACIO's ADT has three power gates plus a separate PCIe clock gate.
		 * Keep the ATC PCIe domain on while starting the M3; without it the
		 * RC aperture faults on T6000 even though the three CIO domains report
		 * active.
		 */
		power-domains = <&DIE_NODE(ps_atc0_cio)>,
			<&DIE_NODE(ps_atc0_cio_pcie)>,
			<&DIE_NODE(ps_atc0_cio_usb)>,
			<&DIE_NODE(ps_atc0_pcie)>;

		thunderbolt-switch;

		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

