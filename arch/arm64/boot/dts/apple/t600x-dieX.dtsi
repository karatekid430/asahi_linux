		/*
		 * T6000 ATC AXI-to-fabric setup observed on macOS before the
		 * power-controller small/big wake sequence.  These registers are
		 * reset by the Linux probe power-off path and must be restored before
		 * the controller transitions from USB3 to Thunderbolt.
		 */
		apple,tunable-axi2af = <0x000 0xffffffff 0x00000011>,
			<0x010 0xffffffff 0x000d0000>,
			<0x014 0xffffffff 0x00000001>,
			<0x018 0xffffffff 0x00000001>,
			<0x01c 0xffffffff 0x00000003>,
