		compatible = "apple,t6000-display-crossbar";
		reg = <0xb 0x0304c000 0x0 0x4000>;
		#mux-control-cells = <1>;
		power-domains = <&DIE_NODE(ps_atc1_usb)>;
		status = "disabled";
	};

	/* USB4 / Thunderbolt host router for USB-C port 2. */
	DIE_NODE(usb4_1_acio): usb4@b01db0000 {
		compatible = "apple,t6000-usb4-acio";
		reg = <0xb 0x01db0000 0x0 0x30004>,
