				<AIC_IRQ DIE_NO 1295 IRQ_TYPE_LEVEL_HIGH>,
				<AIC_IRQ DIE_NO 1296 IRQ_TYPE_LEVEL_HIGH>,
				<AIC_IRQ DIE_NO 1297 IRQ_TYPE_LEVEL_HIGH>,
				<AIC_IRQ DIE_NO 1298 IRQ_TYPE_LEVEL_HIGH>,
