			<&DIE_NODE(ps_atc1_pcie)>;
		thunderbolt-switch;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		DIE_NODE(usb4_1_dart): iommu@b01a80000 {
			compatible = "apple,t6000-dart";
