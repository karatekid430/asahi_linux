	DIE_NODE(atcphy2_xbar): mux@f0304c000 {
		compatible = "apple,t6000-display-crossbar";
		reg = <0xf 0x0304c000 0x0 0x4000>;
		#mux-control-cells = <1>;
		power-domains = <&DIE_NODE(ps_atc2_usb)>;
		status = "disabled";
	};

	/* USB4 / Thunderbolt host router for USB-C port 3. */
	DIE_NODE(usb4_2_acio): usb4@f01db0000 {
		compatible = "apple,t6000-usb4-acio";
		reg = <0xf 0x01db0000 0x0 0x30004>,
			<0xf 0x01ac0000 0x0 0x4000>,
			<0xf 0x01080000 0x0 0x20000>,
			<0xf 0x01ac4000 0x0 0x4000>,
			<0xf 0x01ac8000 0x0 0x4000>,
			<0xf 0x01e44000 0x0 0x4000>;
		reg-names = "ctrl", "rc", "sram", "fabric-rx", "fabric-tx", "pcie";
		apple,tunable-rc = <0x0 0xfff0 0x2010>,
			<0x2c 0x4 0x0>, <0xac 0xffffffff 0x200020>;
		apple,tunable-pcie = <0x1008 0x6 0x6>;
		mboxes = <&DIE_NODE(usb4_2_mbox)>;
		power-domains = <&DIE_NODE(ps_atc2_cio)>,
			<&DIE_NODE(ps_atc2_cio_pcie)>,
			<&DIE_NODE(ps_atc2_cio_usb)>,
			<&DIE_NODE(ps_atc2_pcie)>;
		thunderbolt-switch;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		DIE_NODE(usb4_2_dart): iommu@f01a80000 {
			compatible = "apple,t6000-dart";
			reg = <0xf 0x01a80000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ DIE_NO 1405 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
		};

		DIE_NODE(usb4_2_nhi): nhi@f01f00000 {
			compatible = "apple,t6000-usb4-nhi";
			reg = <0xf 0x01f00000 0x0 0x100000>,
				<0xf 0x01ac0000 0x0 0x4000>;
			reg-names = "nhi", "tunable";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ DIE_NO 1390 IRQ_TYPE_LEVEL_HIGH>,
				<AIC_IRQ DIE_NO 1391 IRQ_TYPE_LEVEL_HIGH>,
				<AIC_IRQ DIE_NO 1392 IRQ_TYPE_LEVEL_HIGH>,
				<AIC_IRQ DIE_NO 1393 IRQ_TYPE_LEVEL_HIGH>,
				<AIC_IRQ DIE_NO 1394 IRQ_TYPE_LEVEL_HIGH>,
